{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "91571643c587481ba62e48852c4712ed",
    "m_Group": {
        "m_Id": "2c70b1c2c453409c90504ca3b947abfc"
    },
    "m_Name": "SampleReflectionProbe (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -1551.0001220703125,
            "y": -1770.0001220703125,
            "width": 288.0,
            "height": 350.0001220703125
        }
    },
    "m_Slots": [
        {
            "m_Id": "abf1afae93d743dc92454bd2ff481cbe"
        },
        {
            "m_Id": "9345e28e9fc14d4fa5265255625c1710"
        },
        {
            "m_Id": "d044bf30521a4d2ca88b90871d2d4f0a"
        },
        {
            "m_Id": "9b3c4e9fa0a04fb0864e09139fed7d26"
        },
        {
            "m_Id": "ef00da8fe490464eb793f5a2e463500a"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 0,
    "m_FunctionName": "SampleReflectionProbe",
    "m_FunctionSource": "d6f7f9c76e5928d4e8f42a4fb227828b",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "#pragma multi_compile _ UNITY_ENABLE_REFLECTION_PROBE_BOX_PROJECTION\n\nfloat3 viewDirWS = normalize(ViewDirWS);\r\nfloat3 normalWS = normalize(NormalWS);\r\nfloat3 reflDir = normalize(reflect(-viewDirWS, normalWS));\r\n\n\nfloat3 factors = ((reflDir > 0 ? unity_SpecCube0_BoxMax.xyz : unity_SpecCube0_BoxMin.xyz) - PositionWS) / reflDir;\r\nfloat scalar = min(min(factors.x, factors.y), factors.z);\r\nfloat3 uvw = reflDir * scalar + (PositionWS - unity_SpecCube0_ProbePosition.xyz);\r\n\r\nfloat4 sampleRefl = SAMPLE_TEXTURECUBE_LOD(unity_SpecCube0, samplerunity_SpecCube0, uvw, LOD);\r\nfloat3 specCol = DecodeHDREnvironment(sampleRefl, unity_SpecCube0_HDR);\r\nColor = specCol;"
}

